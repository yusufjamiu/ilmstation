// IlmWorld Storage rules: paste inside your existing
//   match /b/{bucket}/o { ... }
// block in Firebase console → Storage → Rules, then press Publish.

    // nasheeds: anyone can listen; only IlmWorld admins can upload or delete
    match /nasheeds/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && (request.resource == null || request.resource.size < 20 * 1024 * 1024);
    }
