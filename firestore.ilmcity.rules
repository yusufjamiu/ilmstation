// IlmCity rules. Paste these lines inside your existing
//   match /databases/{database}/documents { ... }
// block in Firebase console → Firestore Database → Rules, then press Publish.
// They only cover the new IlmCity collections and do not change your other rules.

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // where each player is in the city (only their own position can be written)
    match /city_presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // chat limits, pass, blocks and fines
    match /city_players/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid
        // a player may clear their own fine (after paying) but never set one
        && (!('fine' in request.resource.data)
            || request.resource.data.fine == 0
            || (resource != null && request.resource.data.fine == resource.data.get('fine', 0))));
    }

    // conversations between two players
    match /city_chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/city_chats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/city_chats/$(chatId)).data.members
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 400;
        allow read: if isAdmin();
      }
    }

    // reports: anyone signed in can send one; only admins can read them
    match /city_reports/{id} {
      allow create: if signedIn() && request.resource.data.reporter == request.auth.uid;
      allow read, update: if isAdmin();
    }

    // ---- added for IlmWorld: matches, adverts, award, MSSN questions, nasheeds ----

    // football matches between two players
    match /city_matches/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b);
      allow create: if signedIn() && request.resource.data.a == request.auth.uid
        && request.resource.data.status == "invited";
      allow update: if signedIn()
        && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b)
        && request.resource.data.a == resource.data.a
        && request.resource.data.b == resource.data.b;
    }

    // billboard adverts: players ask, the admin approves; everyone sees approved ones
    match /city_ads/{id} {
      allow read: if resource.data.status == "approved"
        || isAdmin()
        || (signedIn() && request.auth.uid == resource.data.from);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }

    // best home of the week: everyone reads, only the admin announces
    match /city_awards/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // questions to the MSSN: players ask and read their own; the admin answers
    match /city_enquiries/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == resource.data.from);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 400;
      allow update, delete: if isAdmin();
    }

    // nasheeds: everyone listens, only the admin uploads
    match /city_nasheeds/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
